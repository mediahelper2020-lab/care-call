# 개인정보 암호화 키 (필수, 운영 환경)
# 32바이트 키를 base64 또는 hex로 지정합니다.
#   openssl rand -base64 32
# 미설정 시 개발 전용 고정키로 동작하며 실제 개인정보를 넣어서는 안 됩니다.
CARE_ENCRYPTION_KEY=

# 개인정보 보유기간(일). 기본 365일.
CARE_RETENTION_DAYS=365

# LLM 제공자: heuristic | anthropic
# heuristic은 외부 API 없이 규칙·휴리스틱으로만 분석합니다.
CARE_LLM_PROVIDER=heuristic
CARE_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# 전화 제공자: simulation (1단계 MVP)
# 2단계에서 실제 Voice API 제공자를 추가하면 여기서 교체합니다.
CARE_CALL_PROVIDER=simulation

# Supabase. 아래 두 값이 채워지면 데이터가 계속 보관됩니다.
# 비워두면 메모리 저장소로 동작하며, 서버가 다시 시작될 때 입력한 내용이 사라집니다.
# Supabase 프로젝트 → Settings → API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
